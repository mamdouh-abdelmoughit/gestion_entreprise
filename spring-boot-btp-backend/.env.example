# ═══════════════════════════════════════════════════════════════════════════════
# GestionBTP — Production environment variables
# Set all of these in the Cloud Run service (gcloud run services update --set-env-vars)
# or in the Cloud Run console → Edit & Deploy → Variables & Secrets.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Spring profile ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Supabase dashboard → Project Settings → Database → Connection string → JDBC
# Format: jdbc:postgresql://db.<ref>.supabase.co:5432/postgres?sslmode=require
# Use the session POOLER URL (IPv4, works everywhere) — NOT the direct host (IPv6 only):
DATABASE_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.qvarhogwgazpwzovbtqz
DB_PASSWORD=your-supabase-db-password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-64-char-hex-string

# ── Supabase Storage ──────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
#   SUPABASE_URL      : "Project URL"  (https://<ref>.supabase.co)
#   SUPABASE_SERVICE_KEY : "service_role" secret key (NOT the anon key)
# Supabase dashboard → Storage → Create bucket named "documents" (set to Public)
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_BUCKET=documents

# ── Email (Brevo recommended — 300 emails/day free, inbox delivery) ───────────
# Sign up at brevo.com → SMTP & API → SMTP → generate key
# Then set MAIL_HOST in Cloud Run too:
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-login@example.com
MAIL_PASSWORD=your-brevo-smtp-key

# ── Frontend URL (used in activation/reset email links) ──────────────────────
FRONTEND_URL=https://your-app.vercel.app

# ── CORS (comma-separated, no spaces) ────────────────────────────────────────
# Include Vercel URL + mobile scheme origins
CORS_ORIGINS=https://your-app.vercel.app,capacitor://localhost,ionic://localhost
